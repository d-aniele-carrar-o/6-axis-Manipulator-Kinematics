<?xml version="1.0" ?>

<robot name="3Dprinted">
<!-- pi   = 3.14159265359 -->
<!-- pi/2 = 1.57079632675 -->

  <link name="base_link" />

  <joint name="joint_1" type="revolute">
    <origin rpy ="0 0 0" xyz="0 0 0" />
    <parent link="base_link"/>
    <child  link="link_1"/>
    <axis    xyz ="0 0 1"/>
    <limit effort="0" lower="-5" upper="5" velocity="3.14"/>
  </joint>

  <link name="link_1" />

  <joint name="joint_2" type="revolute">
    <origin rpy="1.57079632675 0 0" xyz="0.03247 0 0.0922" />
    <parent link="link_1"/>
    <child  link="link_2"/>
    <axis   xyz="0 0 1"/>
    <limit effort="0" lower="-5" upper="5" velocity="3.14"/>
  </joint>

  <link name="link_2" />

  <joint name="joint_3" type="revolute">
    <origin rpy="0 0 0" xyz="0.14042 0 0"/>
    <parent link="link_2"/>
    <child  link="link_3"/>
    <axis   xyz="0 0 1"/>
    <limit effort="0" lower="-5" upper="5" velocity="3.14"/>
  </joint>

  <link name="link_3" />
  
  <joint name="joint_4" type="revolute">
    <origin rpy="1.57079632675 0 0" xyz="0 -0.15457 0"/>
    <parent link="link_3"/>
    <child  link="link_4"/>
    <axis   xyz="0 0 1"/>
    <limit effort="0" lower="-5" upper="5" velocity="3.14"/>
  </joint>

  <link name="link_4" />

  <joint name="joint_5" type="revolute">
    <origin rpy="-1.57079632675 0 0" xyz="0 0 0"/>
    <parent link="link_4"/>
    <child  link="link_5"/>
    <axis   xyz="0 0 1"/>
    <limit effort="0" lower="-5" upper="5" velocity="3.14"/>
  </joint>

  <link name="link_5" />
  
  <joint name="joint_6" type="revolute">
    <origin rpy="1.57079632675 0 0" xyz="0 -0.07 0"/>
    <parent link="link_5"/>
    <child  link="link_6"/>
    <axis   xyz="0 0 1"/>
    <limit effort="0" lower="-5" upper="5" velocity="3.14"/>
  </joint>

  <link name="link_6" />
    
</robot>
